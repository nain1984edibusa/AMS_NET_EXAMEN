{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Elastic.Apm": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "ServiceName": "Payments.Service",
    "Environment": "development",
    "TransactionSampleRate": 1.0
  },
  "Logstash": {
    "Uri": "http://localhost:28080",
    "ServiceName": "Payments.Service",
    "Environment": "development"
  },
  "OtelCollector": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "Payments.Service"
  },
  "ConnectionStrings": {
    "PaymentsConnection": "Host=localhost;Port=5433;Database=Microservices.Demo.Payments;Username=postgres;Password=Password1234"
  },
  "spring": {
    "application": {
      "name": "Payments.Service"
    },
    "cloud": {
      "timeout": "60000",
      "config": {
        "discovery": {
          "enabled": true,
          "serviceId": "Config.Server"
        },
        "retry": {
          "enabled": true
        },
        "failFast": true
      }
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka"
    },
    "Instance": {
      "Port": 5112,
      "PreferIpAddress": true
    }
  },
  "BackgroundProcess": {
    "HangfireConnectionStringName": "Host=localhost;Port=5433;Database=Microservices.Demo.Payments.Jobs;Username=postgres;Password=Password1234",
    "InPaymentFileFolder": "testcases"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "Consumers": {
      "Events": {
        "GroupId": "payment.events.consumer.group",
        "Topics": [
          { "Policy": "policy.events" }
        ]
      }
    }
  }
}
