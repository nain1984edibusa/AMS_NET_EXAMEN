{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Elastic.Apm": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "ServiceName": "Products.Service",
    "Environment": "development",
    "TransactionSampleRate": 1.0
  },
  "Logstash": {
    "Uri": "http://localhost:28080",
    "ServiceName": "Products.Service",
    "Environment": "development"
  },
  "OtelCollector": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "Products.Service"
  },
  "ConnectionStrings": {
    "ProductsConnection": "Server=localhost,1434;Database=Microservices.Demo.Products;User Id=sa;Password=Password1234;TrustServerCertificate=True;Encrypt=False;"
  },
  "spring": {
    "application": {
      "name": "Products.Service"
    },
    "cloud": {
      "timeout": "60000",
      "config": {
        "discovery": {
          "enabled": true,
          "serviceId": "Config.Server"
        },
        "retry": {
          "enabled": true
        },
        "failFast": true
      }
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka"
    },
    "Instance": {
      "Port": 5176,
      "PreferIpAddress": true
    }
  }
  //"Management": {
  //  "Endpoints": {
  //    "Path": "/manage",
  //    "Actuator": {
  //      "Exposure": {
  //        "Include": [ "*" ],
  //        "Exclude": [ "env", "refresh" ]
  //      }
  //    }
  //  }
  //}
}
