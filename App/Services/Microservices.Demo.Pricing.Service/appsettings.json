{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Elastic.Apm": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "ServiceName": "Pricing.Service",
    "Environment": "development",
    "TransactionSampleRate": 1.0
  },
  "Logstash": {
    "Uri": "http://localhost:28080",
    "ServiceName": "Pricing.Service",
    "Environment": "development"
  },
  "OtelCollector": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "Pricing.Service"
  },
  "ConnectionStrings": {
    "PricingConnection": "Host=localhost;Port=5433;Database=Microservices.Demo.Pricing;Username=postgres;Password=Password1234"
  },
  "spring": {
    "application": {
      "name": "Pricing.Service"
    },
    "cloud": {
      "timeout": "60000",
      "config": {
        "discovery": {
          "enabled": true,
          "serviceId": "Config.Server"
        },
        "retry": {
          "enabled": true
        },
        "failFast": true
      }
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka"
    },
    "Instance": {
      "Port": 5194,
      "PreferIpAddress": true
    }
  }
}
