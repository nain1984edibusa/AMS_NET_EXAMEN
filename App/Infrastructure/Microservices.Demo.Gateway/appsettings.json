{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Elastic.Apm": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Server": "http://localhost:8992",
    "Realm": "microservices-demo",
    "Issuer": "http://localhost:8992/realms/microservices-demo",
    "Authority": "http://localhost:8992/realms/microservices-demo"
  },
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "ServiceName": "Gateway",
    "Environment": "development",
    "TransactionSampleRate": 1.0
  },
  "Logstash": {
    "Uri": "http://localhost:28080",
    "ServiceName": "Gateway",
    "Environment": "development"
  },
  "OtelCollector": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "Gateway"
  },
  "spring": {
    "application": {
      "name": "Gateway"
    },
    "cloud": {
      "timeout": "60000",
      "config": {
        "discovery": {
          "enabled": true,
          "serviceId": "Config.Server"
        },
        "retry": {
          "enabled": true
        },
        "failFast": true
      }
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka"
    },
    "Instance": {
      "AppName": "gateway",
      "Port": "5058",
      "PreferIpAddress": false
    }
  }
}
